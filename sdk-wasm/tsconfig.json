{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "dist",
    "rootDir": "typescript",
    "skipLibCheck": false
  },
  "include": [
    "typescript/**/*.ts",
    "typescript/**/*.mts"
  ]
}
